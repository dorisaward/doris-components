{
  "name": "@dorisaward/doris-components",
  "version": "1.0.0",
  "description": "A React Native component library with theme support",
  "main": "index.ts",
  "types": "index.ts",
  "files": [
    "components",
    "theme",
    "index.ts",
    "!**/__tests__/**",
    "!**/*.test.*",
    "!**/*.snap",
    "!__tests__/testHelpers.tsx"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint . && prettier --check .",
    "lintfix": "eslint . --fix && prettier --write .",
    "type-check": "tsc --noEmit",
    "ci": "npm run lint && npm run type-check && npm run test:ci"
  },
  "dependencies": {
    "expo": "~54.0.34",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "peerDependencies": {
		"expo": ">=54.0.34",
    "react": ">=19.1.0",
    "react-native": ">=0.81.5"
  },
  "devDependencies": {
    "@react-native-community/eslint-config": "^3.2.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "3.8.3",
    "typescript": "~5.9.2"
  },
  "keywords": [
    "react-native",
    "components",
    "ui-library",
    "theme",
    "typescript",
    "expo"
  ],
  "author": "DorisAWard",
  "license": "MIT",
  "private": false,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-vector-icons|@expo/config|@expo/json-file|@expo/metro-config|@expo/constants|@unimodules/.*|unimodules|sentry-expo|native-base|@react-navigation/.*|@sentry/.*)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.(ts|tsx|js|jsx)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ]
  }
}
